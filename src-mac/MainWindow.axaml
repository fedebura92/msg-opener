<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MSGViewer.MainWindow"
        Title="MSG Opener"
        Icon="/Assets/msg_opener.png"
        Width="1050"
        Height="760"
        MinWidth="760"
        MinHeight="520"
        Background="{DynamicResource WindowBg}">

  <Grid RowDefinitions="Auto,Auto,*,Auto,Auto">

    <!-- ============ BARRA SUPERIOR ============ -->
    <Border Grid.Row="0"
            Background="{DynamicResource Surface}"
            BorderBrush="{DynamicResource BorderLight}"
            BorderThickness="0,0,0,1"
            Padding="22,12">

      <Grid ColumnDefinitions="*,Auto">

        <StackPanel Orientation="Horizontal" Spacing="11" VerticalAlignment="Center">
          <Image Source="/Assets/msg_opener.png" Width="38" Height="38" />
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="MSG Opener"
                       FontSize="17"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimary}" />
            <TextBlock x:Name="SubtitleText"
                       FontSize="11"
                       Foreground="{DynamicResource TextSecondary}" />
          </StackPanel>
        </StackPanel>

        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="8"
                    VerticalAlignment="Center">
          <Button x:Name="OpenButton" Classes="accent" Click="Open_Click" />
          <Button x:Name="SettingsButton" Click="Settings_Click" />
        </StackPanel>

      </Grid>
    </Border>

    <!-- ============ DATOS DEL CORREO ============ -->
    <Border Grid.Row="1"
            Background="{DynamicResource Surface}"
            BorderBrush="{DynamicResource BorderLight}"
            BorderThickness="1"
            CornerRadius="10"
            Margin="20,18,20,0"
            Padding="24,20">

      <StackPanel Spacing="6">

        <TextBlock x:Name="SubjectText"
                   FontSize="21"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource TextPrimary}" />

        <Grid ColumnDefinitions="95,*,Auto" Margin="0,8,0,0">
          <TextBlock x:Name="FromLabel" FontSize="12" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextSecondary}" />
          <SelectableTextBlock x:Name="FromText" Grid.Column="1" Text="—" FontSize="13"
                     TextWrapping="Wrap" Foreground="{DynamicResource TextPrimary}" />
          <TextBlock x:Name="DateText" Grid.Column="2" Text="—" FontSize="12" Margin="20,0,0,0"
                     Foreground="{DynamicResource TextSecondary}" />
        </Grid>

        <Grid ColumnDefinitions="95,*">
          <TextBlock x:Name="ToLabel" FontSize="12" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextSecondary}" />
          <SelectableTextBlock x:Name="ToText" Grid.Column="1" Text="—" FontSize="12"
                     TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" />
        </Grid>

        <Grid ColumnDefinitions="95,*">
          <TextBlock x:Name="CcLabel" FontSize="12" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextSecondary}" />
          <SelectableTextBlock x:Name="CcText" Grid.Column="1" Text="—" FontSize="12"
                     TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" />
        </Grid>

      </StackPanel>
    </Border>

    <!-- ============ CUERPO DEL CORREO ============ -->
    <Border Grid.Row="2"
            Background="{DynamicResource Surface}"
            BorderBrush="{DynamicResource BorderLight}"
            BorderThickness="1"
            CornerRadius="10"
            Margin="20,12">

      <Grid RowDefinitions="Auto,*">

        <Button x:Name="FormattedButton"
                HorizontalAlignment="Right"
                Margin="0,10,12,0"
                IsEnabled="False"
                Click="Formatted_Click" />

        <ScrollViewer Grid.Row="1">
          <SelectableTextBlock x:Name="BodyText"
                               Margin="22,8,22,20"
                               FontSize="14"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextPrimary}" />
        </ScrollViewer>

      </Grid>
    </Border>

    <!-- ============ ADJUNTOS ============ -->
    <Border Grid.Row="3"
            Background="{DynamicResource Surface}"
            BorderBrush="{DynamicResource BorderLight}"
            BorderThickness="1"
            CornerRadius="10"
            Margin="20,0,20,10"
            Padding="18,12">

      <StackPanel Spacing="8">

        <TextBlock x:Name="AttachmentHeader"
                   FontSize="13"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimary}" />

        <ScrollViewer MaxHeight="130">
          <ItemsControl x:Name="AttachmentsList">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Background="{DynamicResource ItemBg}"
                        BorderBrush="{DynamicResource ItemBorder}"
                        BorderThickness="1"
                        CornerRadius="7"
                        Padding="9,7"
                        Margin="0,3">
                  <Grid ColumnDefinitions="*,Auto,Auto">

                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="{Binding FileName}"
                                 FontSize="12"
                                 FontWeight="SemiBold"
                                 TextTrimming="CharacterEllipsis"
                                 Foreground="{DynamicResource TextPrimary}" />
                      <TextBlock Text="{Binding SizeText}"
                                 FontSize="10"
                                 Foreground="{DynamicResource TextSecondary}" />
                    </StackPanel>

                    <Button Grid.Column="1"
                            Classes="attOpen"
                            Content="{Binding OpenLabel}"
                            Tag="{Binding}"
                            Margin="4,0,0,0" />

                    <Button Grid.Column="2"
                            Classes="attSave"
                            Content="{Binding SaveLabel}"
                            Tag="{Binding}"
                            Margin="4,0,0,0" />

                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

      </StackPanel>
    </Border>

    <!-- ============ PIE DE PÁGINA ============ -->
    <TextBlock Grid.Row="4"
               x:Name="FooterText"
               FontSize="11"
               HorizontalAlignment="Right"
               Margin="0,0,24,12"
               Foreground="{DynamicResource TextSecondary}" />

  </Grid>
</Window>
