<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MSGViewer.App"
             RequestedThemeVariant="Default">

  <Application.Styles>
    <FluentTheme />

    <!-- Botones: texto centrado, esquinas redondeadas y tamaño parejo -->
    <Style Selector="Button">
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Padding" Value="18,0" />
      <Setter Property="MinHeight" Value="38" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="Medium" />
    </Style>
    <Style Selector="Button.attOpen, Button.attSave">
      <Setter Property="Padding" Value="14,0" />
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="CornerRadius" Value="7" />
    </Style>
    <Style Selector="Button > TextBlock">
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </Application.Styles>

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>

        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="WindowBg">#F3F4F6</SolidColorBrush>
          <SolidColorBrush x:Key="Surface">#FFFFFF</SolidColorBrush>
          <SolidColorBrush x:Key="TextPrimary">#202124</SolidColorBrush>
          <SolidColorBrush x:Key="TextSecondary">#6B7280</SolidColorBrush>
          <SolidColorBrush x:Key="BorderLight">#E5E7EB</SolidColorBrush>
          <SolidColorBrush x:Key="ItemBg">#F9FAFB</SolidColorBrush>
          <SolidColorBrush x:Key="ItemBorder">#E5E7EB</SolidColorBrush>
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="WindowBg">#0A0A0A</SolidColorBrush>
          <SolidColorBrush x:Key="Surface">#161618</SolidColorBrush>
          <SolidColorBrush x:Key="TextPrimary">#F3F4F6</SolidColorBrush>
          <SolidColorBrush x:Key="TextSecondary">#9CA3AF</SolidColorBrush>
          <SolidColorBrush x:Key="BorderLight">#2A2A2E</SolidColorBrush>
          <SolidColorBrush x:Key="ItemBg">#1C1C1F</SolidColorBrush>
          <SolidColorBrush x:Key="ItemBorder">#2E2E33</SolidColorBrush>
        </ResourceDictionary>

      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>

</Application>
